{
    "secret_key_env": "SECRET_KEY",
    "users_db": "path/to/credentials.txt",
    "access_token_expiration_hours": 12,
    "max_access_token_expiration_hours": 8760,
    "log": "sentinel.log",
    "log_levels": ["INFO"],
    "whitelist": "whitelist.txt",
    "blacklist": "blacklist.txt",
    "blacklist_after_attempts": 0,
    "free_memory_on_logout": false,
    "force_https": false,
    "seperate_users": true,
    "user_loras_base": "path/to/Lora",
    "user_outputs_base": "path/to/output",
    "manager_admin_only": false
}